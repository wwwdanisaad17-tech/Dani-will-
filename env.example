# Copy this file to .env and fill in your real Stripe keys.
# Get them from https://dashboard.stripe.com/test/apikeys (start in TEST mode).

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# From https://dashboard.stripe.com/test/webhooks after you add an endpoint
# pointing at https://YOUR-DOMAIN/webhook (see README for local testing with the Stripe CLI).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
